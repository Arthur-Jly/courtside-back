{
  "name": "courtside-back",
  "version": "1.0.0",
  "description": "Backend for the courtside application",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "migrate": "node scripts/migrate.js",
    "seed:admin": "node scripts/seed-admin.js",
    "places:import": "node scripts/import-public-places.js",
    "places:osm": "node scripts/crosscheck-osm.js",
    "places:curate": "node scripts/curate-places.js",
    "schema:doc": "node scripts/schema-doc.js ../courtside-front/docs/SCHEMA.md",
    "schema:baseline": "node scripts/baseline-schema.js",
    "test:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=junit.xml test/*.test.js",
    "test:integration": "node --test test/integration/*.int.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "chalk": "^4.1.2",
    "cheerio": "^1.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.14.5",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.3",
    "stripe": "^20.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "globals": "^17.7.0",
    "nodemon": "^3.0.1"
  },
  "author": "",
  "license": "ISC",
  "keywords": [],
  "type": "commonjs"
}
