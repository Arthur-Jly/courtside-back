# --- Server ---
NODE_ENV=development
PORT=3001
# Cron schedules (04:00 cleanup, 09:00 J-1 reminders) and MySQL timestamp
# conversions follow the process timezone. Set it explicitly in production.
TZ=Europe/Paris
# Comma-separated allowlist of origins. NEVER use "*" in production.
CORS_ORIGIN=http://localhost:5173

# --- Database (MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sport

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Must be at least 32 chars. NEVER ship a default value.
JWT_SECRET=replace-with-strong-random-48-byte-base64
JWT_TTL=2h
BCRYPT_ROUNDS=12

# --- Third-party services ---
# Server-side ONLY: do not expose to the frontend.
GOOGLE_MAPS_API_KEY=
# Terrains publics : une zone jamais cherchée est chargée depuis Data ES à la
# première recherche. Mettre `false` pour ne lire que la base (import manuel).
PLACES_LAZY_IMPORT=true
# Recoupement des terrains avec la BD TOPO de l'IGN à la recherche. `false` pour le couper.
PLACES_VERIFY=true
PRIVATE_STRIPE_KEY=
STRIPE_WEBHOOK_SECRET=

# Public frontend URL used to build Stripe redirect URLs and email links.
FRONTEND_URL=http://localhost:5173

# --- Transactional email (SMTP) ---
# Any provider works (Resend, Brevo, Postmark, Mailgun...).
# Leave SMTP_HOST empty in dev: emails are logged instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Courtside <no-reply@courtside.fr>

# --- Object storage (S3-compatible: AWS S3, Cloudflare R2, Scaleway...) ---
# Leave S3_BUCKET empty in dev: files go to the local uploads/ folder.
# S3_PUBLIC_URL = base URL that serves the bucket publicly.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# --- Réservations ---
# Frais de service (€) ajoutés au tarif horaire : le serveur recalcule le prix,
# ce montant doit rester identique à celui affiché par le front.
RESERVATION_SERVICE_FEE=1.5
# POST /slots/:id/book réserve SANS paiement (l'app mobile actuelle l'utilise).
# Laisser à false en production : le paiement passe par Stripe Checkout.
ALLOW_DIRECT_BOOKING=false
